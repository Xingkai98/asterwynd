+def test_report_model_dir_escapes_slash_like_harness() -> None:
+    """路径转义与 harness 目录命名一致：model 名含 '/' 时报告目录可定位。"""
+    adapter = SwebenchAdapter(model="claude/claude-fable-5[1m]")
+    model_name = adapter._prediction_model_name()
+    assert model_name == "asterwynd:claude/claude-fable-5[1m]"
+    assert adapter._report_model_dir(model_name) == "asterwynd:claude__claude-fable-5[1m]"
+    assert "/" not in adapter._report_model_dir(model_name)
