index b11cdf7..c4ad5f0 100644
--- a/tests/agent/tools/test_command_guard.py
+++ b/tests/agent/tools/test_command_guard.py
@@ -199,3 +199,24 @@ class TestCommandGuardLastReason:
         assert g.last_reason == "denylist"
         g.check("git status")
         assert g.last_reason is None
+
+
+class TestMvCpWorkspaceBoundary:
+    def test_mv_to_outside_workspace_denied(self) -> None:
+        g = CommandGuard(workspace="/repo/ws")
+        assert g.check("mv app.py /tmp/leak.py") is CommandVerdict.DENY
+        assert g.last_reason == "mv_cp_dest"
+
+    def test_cp_to_outside_workspace_denied(self) -> None:
+        g = CommandGuard(workspace="/repo/ws")
+        assert g.check("cp app.py /home/user/out.py") is CommandVerdict.DENY
+        assert g.last_reason == "mv_cp_dest"
+
+    def test_mv_within_workspace_allowed(self) -> None:
+        g = CommandGuard(workspace="/repo/ws")
+        assert g.check("mv app.py backup.py") is CommandVerdict.ALLOW
+        assert g.check("mv app.py /repo/ws/backup.py") is CommandVerdict.ALLOW
+
+    def test_mv_without_workspace_keeps_default_allow(self) -> None:
+        g = CommandGuard()
+        assert g.check("mv app.py /tmp/leak.py") is CommandVerdict.ALLOW
