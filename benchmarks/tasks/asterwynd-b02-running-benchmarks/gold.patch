index 0000000..561fcd7
--- /dev/null
+++ b/agent/tools/builtin/benchmarks.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from agent.tools.base import Tool, tool_parameters
+from agent.tool_permissions import WORKSPACE_READ_PERMISSION
+
+
+@tool_parameters(
+    name="ListRunningBenchmarks",
+    description=(
+        "列出 benchmark 评测输出目录中的评测轮次：每轮次一个子目录（目录名即 "
+        "run_id），已完成的含 run.json 元数据（status/passed/task_count），"
+        "尚无元数据的视为进行中（in_progress）。"
+    ),
+    parameters={"type": "object", "properties": {}},
+)
+class ListRunningBenchmarksTool(Tool):
+    """只读工具：列出 benchmark 评测轮次及其状态。"""
+
+    read_only = True
+    parallelizable = True
+    permission = WORKSPACE_READ_PERMISSION
+
+    def __init__(self, runs_dir: str | Path | None = None):
+        self.runs_dir = Path(runs_dir) if runs_dir else Path("benchmarks/runs")
+
+    async def execute(self, **kwargs) -> str:
+        if not self.runs_dir.is_dir():
+            return "(no benchmark runs)"
+        lines: list[str] = []
+        for run_dir in sorted(p for p in self.runs_dir.iterdir() if p.is_dir()):
+            meta = run_dir / "run.json"
+            if meta.is_file():
+                try:
+                    data = json.loads(meta.read_text(encoding="utf-8"))
+                    status = data.get("status", "unknown")
+                    passed = data.get("passed", "?")
+                    total = data.get("task_count", "?")
+                    lines.append(f"{run_dir.name} | {status} | {passed}/{total}")
+                except (ValueError, OSError):
+                    lines.append(f"{run_dir.name} | unknown")
+            else:
+                lines.append(f"{run_dir.name} | in_progress")
+        if not lines:
+            return "(no benchmark runs)"
+        return "\n".join(lines)
