+def _infer_track(result: TaskResult) -> str:
+    """Infer track (A|B|verified) from the result when the field is missing.
+
+    Tracks mirror the task.json ``track`` single source of truth; older run
+    artifacts without the field fall back to the task-id convention
+    (``swebench-`` -> verified, ``asterwynd-b`` -> B, otherwise A).
+    """
+    track = (result.track or "").strip()
+    if track:
+        return track
+    if result.task_id.startswith("swebench-"):
+        return "verified"
+    if result.task_id.startswith("asterwynd-b"):
+        return "B"
+    return "A"
+
