+"""Context-source rendering helpers owned by the memory layer.
+
+LC-1: the memory-summary injection logic used to live inline in
+``agent/context/sources.py`` (MemoryIndexSource.render). The memory layer now
+owns how its summaries are surfaced to context; the context source delegates
+here. Behavior is unchanged: an empty summary yields an empty string.
+"""
+from __future__ import annotations
+
+from agent.memory.persistent import PersistentMemory
+
+
+def render_memory_index(memory: PersistentMemory) -> str:
+    """Build the '## Project Memory' context block from a persistent memory store.
+
+    Returns an empty string when the store has no summary to inject.
+    """
+    summary = memory.load_summary()
+    if not summary:
+        return ""
+    return (
+        "## Project Memory\n"
+        "Summary of persistent memories from prior sessions. "
+        "Use SearchMemory to semantically retrieve specific entries.\n"
+        "---\n"
+        f"{summary}\n"
+        "---"
+    )
