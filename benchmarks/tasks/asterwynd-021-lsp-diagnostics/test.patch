@@ -274,3 +274,22 @@ async def test_tools_registered_in_factory(
         "LspDiagnostics",
     ):
         assert name in KNOWN_BUILTIN_TOOL_NAMES
+
+
+@pytest.mark.asyncio
+async def test_diagnostics_tool_language_override_for_extensionless_file(
+    lsp_manager: LspClientManager,
+    policy: WorkspacePolicy,
+    workspace: Path,
+    transport: FakeLspTransport,
+):
+    extless = workspace / "README"
+    extless.write_text("import missing\n", encoding="utf-8")
+    transport.on("textDocument/diagnostic", result={"items": []})
+
+    tool = LspDiagnosticsTool(policy=policy, lsp_manager=lsp_manager)
+    default_result = await tool.execute(path="README")
+    assert "no LSP server" in default_result
+
+    override_result = await tool.execute(path="README", language="python")
+    assert "no diagnostics" in override_result
