+def test_render_report_contains_task_family_section() -> None:
+    aggregates = aggregate_results(
+        [
+            [
+                _result("swebench-abc", "passed", task_family="swebench"),
+                _result("local-001", "failed", reason="test_failure", task_family="local"),
+            ]
+        ]
+    )
+    md = render_report(aggregates)
+    assert "## By Task Family" in md
+    assert "| swebench | 1 | 1.00 |" in md
+    assert "| local | 1 | 0.00 |" in md
