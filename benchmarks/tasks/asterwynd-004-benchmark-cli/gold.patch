+def _echo_task_set(tasks_dir: Path) -> None:
+    # List the task set (ids + total) without running the benchmark.
+    from benchmarks.task_schema import load_task
+
+    task_dirs = sorted(
+        p for p in tasks_dir.iterdir() if p.is_dir() and (p / "task.json").exists()
+    )
+    typer.echo(f"Tasks: {len(task_dirs)}")
+    for d in task_dirs:
+        try:
+            task = load_task(d).task
+        except (ValueError, FileNotFoundError) as exc:
+            typer.echo(f"Error: failed to load {d.name}: {exc}", err=True)
+            continue
+        typer.echo(f"  {task.id}")
+
+
