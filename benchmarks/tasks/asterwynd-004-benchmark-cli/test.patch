         capture_output=True,
         text=True,
     ).stdout.strip()
+
+
+def test_benchmark_cli_list_tasks_shows_task_ids(tmp_path):
+    tasks_dir = tmp_path / "tasks"
+    for tid in ("local-1", "swe-1"):
+        d = tasks_dir / tid
+        d.mkdir(parents=True)
+        (d / "issue.md").write_text("Do it\n")
+        (d / "task.json").write_text(
+            json.dumps(
+                {
+                    "id": tid,
+                    "repo": "local",
+                    "base_commit": "abc",
+                    "problem_statement_file": "issue.md",
+                    "test_command": "pytest",
+                }
+            )
+        )
+
+    result = CliRunner().invoke(
+        cli.app, ["benchmark", "--list-tasks", str(tasks_dir)]
+    )
+
+    assert result.exit_code == 0
+    assert "Tasks: 2" in result.output
+    assert "local-1" in result.output
+    assert "swe-1" in result.output
+
+
+def test_benchmark_cli_list_tasks_does_not_run_benchmark(tmp_path, monkeypatch):
+    tasks_dir = tmp_path / "tasks"
+    d = tasks_dir / "local-1"
+    d.mkdir(parents=True)
+    (d / "issue.md").write_text("Do it\n")
+    (d / "task.json").write_text(
+        json.dumps(
+            {
+                "id": "local-1",
+                "repo": "local",
+                "base_commit": "abc",
+                "problem_statement_file": "issue.md",
+                "test_command": "pytest",
+            }
+        )
+    )
+
+    def _boom(*args, **kwargs):
+        raise AssertionError("benchmark runner must not run in --list-tasks mode")
+
+    monkeypatch.setattr("agent.main._build_benchmark_runner", _boom)
+    result = CliRunner().invoke(
+        cli.app, ["benchmark", "--list-tasks", str(tasks_dir)]
+    )
+    assert result.exit_code == 0
+    assert "Tasks: 1" in result.output
+    assert "local-1" in result.output
